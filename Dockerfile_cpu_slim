# Slim variant of Dockerfile_cpu: no dev / docs dependencies, no Open3D, and only a minimal build toolchain in the target image

FROM ubuntu:24.04 AS builder

WORKDIR /workspace

ENV DEBIAN_FRONTEND=noninteractive

ENV PYTHON_VERSION=3.13.12

ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    libbz2-dev \
    libffi-dev \
    liblzma-dev \
    libreadline-dev \
    libsqlite3-dev \
    libssl-dev \
    wget \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

######################## Python installation #########################

# Download Python source code from official site and build it
# afterwards, remove the test suite, the static library, and the byte code for optimization levels 1 and 2
# (only used with python -O / -OO) to reduce the image size
RUN wget https://www.python.org/ftp/python/$PYTHON_VERSION/Python-$PYTHON_VERSION.tgz && \
    tar -zxf Python-$PYTHON_VERSION.tgz && \
    cd Python-$PYTHON_VERSION && \
    ./configure --enable-optimizations && make -j$(nproc) && make install && \
    cd .. && \
    rm Python-$PYTHON_VERSION.tgz && \
    rm -r Python-$PYTHON_VERSION && \
    find /usr/local/lib/python3.13 -depth \
        \( \( -type d -a \( -name test -o -name tests -o -name idle_test \) \) \
        -o \( -type f -a \( -name '*.opt-1.pyc' -o -name '*.opt-2.pyc' -o -name 'libpython*.a' \) \) \) \
        -exec rm -rf '{}' +

RUN wget https://bootstrap.pypa.io/get-pip.py -O get-pip.py

#################### Create Virtual Environment ######################

ENV VIRTUAL_ENV=/workspace/venv
RUN python3.13 -m venv $VIRTUAL_ENV

# by adding the venv to the search path, we avoid activating it in each command
# see https://pythonspeed.com/articles/activate-virtualenv-dockerfile/
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# install pip into venv
RUN python get-pip.py && python -m pip install --upgrade pip

######## Install PyTorch and packages that depend on PyTorch #########

# these packages are needed to build PyTorch3D without build isolation
RUN python -m pip install setuptools wheel packaging
RUN python -m pip install torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install torch-scatter torch-cluster -f https://data.pyg.org/whl/torch-2.10.0+cpu.html
RUN python -m pip install --no-build-isolation "git+https://github.com/facebookresearch/pytorch3d.git@stable"
RUN python -m pip install spconv

######################## pointtorch installation ######################

# the package is installed in the builder stage so that the source code is not part of the target image
COPY . /workspace/pointtorch
RUN python -m pip install /workspace/pointtorch

####################################################################
######################### Target Image #############################
####################################################################

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

ENV PYTHON_VERSION=3.13.12

ENV PIP_NO_CACHE_DIR=1

WORKDIR /workspace

# besides a C/C++ compiler (needed e.g. by torch.compile / Triton), only the runtime libraries of the Python build are installed
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    g++ \
    gcc \
    git \
    libatomic1 \
    libbz2-1.0 \
    libc6-dev \
    libffi8 \
    libgomp1 \
    liblzma5 \
    libreadline8t64 \
    libsqlite3-0 \
    libssl3t64 \
    tzdata \
    unrar \
    unzip \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

######################## Rclone installation ########################

RUN curl https://rclone.org/install.sh | bash

#################### Copy Virtual Environment ######################

ENV VIRTUAL_ENV=/workspace/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# copy Python installation to avoid building Python twice
COPY --from=builder /usr/local/bin/python3.13 /usr/local/bin/python3.13
COPY --from=builder /usr/local/lib/python3.13 /usr/local/lib/python3.13
COPY --from=builder /usr/local/include/python3.13 /usr/local/include/python3.13

COPY --from=builder /workspace/venv /workspace/venv
